<resources>
    <style name="Theme.BaonTracker" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/purple_main</item>
        <item name="colorOnPrimary">@color/purple_dark</item>
        <item name="colorPrimaryContainer">@color/purple_pastel</item>
        <item name="colorOnPrimaryContainer">@color/purple_dark</item>
        <item name="colorSecondary">@color/purple_main</item>
        <item name="colorSecondaryContainer">@color/purple_pastel</item>
        <item name="colorOnSecondaryContainer">@color/purple_dark</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorSurfaceContainer">@color/white</item>
        <item name="colorError">@color/error</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@color/yellow_pastel</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="materialButtonStyle">@style/Widget.BaonTracker.Button</item>
        <item name="textInputStyle">@style/Widget.BaonTracker.TextInput</item>
    </style>

    <style name="Widget.BaonTracker.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/purple_pastel</item>
        <item name="android:textColor">@color/purple_dark</item>
        <item name="strokeColor">@color/purple_main</item>
        <item name="strokeWidth">2dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.BaonTracker.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">@color/text_primary</item>
        <item name="strokeColor">@color/card_stroke</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.BaonTracker.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">10dp</item>
        <item name="boxCornerRadiusTopEnd">10dp</item>
        <item name="boxCornerRadiusBottomStart">10dp</item>
        <item name="boxCornerRadiusBottomEnd">10dp</item>
        <item name="boxStrokeColor">@color/purple_main</item>
        <item name="hintTextColor">@color/purple_dark</item>
    </style>

    <style name="Widget.BaonTracker.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/yellow_pastel</item>
        <item name="titleCentered">true</item>
        <item name="titleTextAppearance">@style/TextAppearance.BaonTracker.ToolbarTitle</item>
        <item name="android:minHeight">?attr/actionBarSize</item>
    </style>

    <style name="TextAppearance.BaonTracker.ToolbarTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">19sp</item>
    </style>

    <style name="Widget.BaonTracker.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/white</item>
        <item name="strokeColor">@color/card_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">0dp</item>
    </style>

    <style name="Widget.BaonTracker.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_bg</item>
        <item name="chipStrokeColor">@color/chip_stroke</item>
        <item name="chipStrokeWidth">1.5dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="BaonTracker.SectionLabel">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="BaonTracker.Row">
        <item name="android:padding">16dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>
</resources>
